# EchoSheets — environment configuration
#
# The browser app runs fully client-side by default ("bring your own key"):
# users enter provider credentials in Settings (⌘,) and they are stored only
# in that browser's local storage.
#
# These variables are reserved for an optional server-side proxy deployment
# (Hono API under /api) so keys never reach the browser. Not required for the
# static GitHub Pages deployment.

# Default OpenAI-compatible base URL used by the server proxy
# Examples: https://api.openai.com/v1 · https://openrouter.ai/api/v1
#           https://api.groq.com/openai/v1 · http://localhost:11434/v1 (Ollama)
ECHOSHEETS_API_BASE_URL=https://api.openai.com/v1

# Server-side API key for the proxy (never expose this to clients)
ECHOSHEETS_API_KEY=

# Model id used when a request doesn't specify one
ECHOSHEETS_DEFAULT_MODEL=gpt-4o-mini

# Max upload size for CSV imports handled through the server (bytes)
ECHOSHEETS_MAX_UPLOAD_BYTES=209715200
