{
  "name": "echosheets",
  "version": "0.1.0",
  "description": "EchoSheets — the AI-native spreadsheet. Upload data, transform it with natural language, preview every change, export anywhere.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@types/lodash": "^4.17.25",
    "canvas-hypertxt": "^1.0.3",
    "cmdk": "^1.1.1",
    "comlink": "^4.4.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.33.0",
    "marked": "^18.0.10",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-number-format": "^5.4.5",
    "react-responsive-carousel": "^3.2.23",
    "sonner": "^2.0.8",
    "udsv": "^0.7.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
